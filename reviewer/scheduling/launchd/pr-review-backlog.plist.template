<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Generated by scheduling/install-launchd.sh for the PR-review backlog run.
  Do not hand-edit: re-running the installer overwrites it (edit the template
  alongside this file instead). launchd does not expand ~, $HOME, or env vars in
  these fields, so they are filled with absolute literals per machine.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SCRIPT__</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>LIMIT</key>
    <string>__LIMIT__</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <!-- Standard, not Background: Background QoS aggressively throttles CPU and
       (especially) network, which starves agy's streaming model calls and causes
       intermittent hangs / empty reviews under launchd. Standard = normal
       priority for an unattended job that does real network/LLM work. -->
  <key>ProcessType</key>
  <string>Standard</string>
__SCHEDULE_BLOCK__
  <key>StandardOutPath</key>
  <string>__OUT_LOG__</string>
  <key>StandardErrorPath</key>
  <string>__ERR_LOG__</string>
</dict>
</plist>
